@page
@model MediTrack.Microsoft.Pages.Patients.IndexModel
@{
    ViewData["Title"] = "Pacientes";
}

<div class="page-heading">
    <div><span class="eyebrow">CONSULTA SQL SERVER</span><h1>Pacientes registrados</h1></div>
    <a class="button-link" asp-page="/Patients/Create">Nuevo paciente</a>
</div>

<form method="get" class="searchbar">
    <input asp-for="Search" placeholder="Buscar por nombre, apellido o correo" />
    <button type="submit">Buscar</button>
</form>

<div class="table-wrap">
<table>
    <thead><tr><th>Paciente</th><th>Correo</th><th>Teléfono</th><th>Fecha de registro</th></tr></thead>
    <tbody>
    @foreach (var patient in Model.Patients)
    {
        <tr>
            <td><strong>@patient.FirstName @patient.LastName</strong></td>
            <td>@(patient.Email ?? "—")</td>
            <td>@(patient.Phone ?? "—")</td>
            <td>@patient.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
        </tr>
    }
    </tbody>
</table>
</div>
